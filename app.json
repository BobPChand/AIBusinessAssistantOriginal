{
  "expo": {
    "name": "AI Business Assistant Original",
    "slug": "ai-business-assistant-original",
    "version": "1.0.0",
    "sdkVersion": "52.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.aibusinessassistant.original.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AI Business Assistant Original uses your microphone for hands-free voice input.",
        "NSSpeechRecognitionUsageDescription": "AI Business Assistant Original uses speech recognition to capture task and chat input.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "package": "ai.aibusinessassistant.original.app",
      "permissions": [
        "RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A1628"
        }
      ]
    ],
    "extra": {
      "apiEndpoint": "https://superagent-02ccfade.base44.app/functions/aiChat",
      "eas": {
        "projectId": "46213b86-0811-4faf-809b-07816cbd53db"
      }
    },
    "owner": "aibusinessassistant.ai"
  }
}
